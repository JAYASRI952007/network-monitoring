# Copy this file to .env and fill in the values.
# .env is git-ignored and must never be committed.

# Hostname Caddy serves. Use your server's public IP with sslip.io,
# or a domain whose DNS A record points at the server.
# Example: monitor.203.0.113.10.sslip.io
SITE_ADDRESS=monitor.203.0.113.10.sslip.io

# Dashboard login
ADMIN_USER=admin

# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YourStrongPassword'
# Keep the single quotes in .env so the $ characters are not interpolated.
ADMIN_PASSWORD_HASH='$2a$14$replace_with_generated_hash'
